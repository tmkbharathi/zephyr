config SOC_FAMILY_TI_AM335X
	bool

config SOC_FAMILY
	default "ti_am335x" if SOC_FAMILY_TI_AM335X

config SOC_SERIES_AM335X
	bool
	select SOC_FAMILY_TI_AM335X

config SOC_SERIES
	default "am335x" if SOC_SERIES_AM335X

config SOC_AM3358
	bool
	select SOC_SERIES_AM335X
	select CPU_CORTEX_A8
	select ARM
	select ARM_CUSTOM_INTERRUPT_CONTROLLER

config SOC
	default "am3358" if SOC_AM3358
